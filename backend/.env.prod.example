# ============================================================
# Fashion App — Backend PRODUCTION environment template
# Copy to .env.prod and fill in.  Load it with APP_ENV=prod.
# NEVER commit the real .env.prod — only this .example.
# In real hosting you normally set these as the platform's env vars
# (Railway/Render/Fly secrets) rather than a file on disk.
# ============================================================

ENVIRONMENT=prod

# CORS: explicit origins only, comma-separated (no "*" outside dev — the app
# refuses to boot). e.g. http://localhost:8081 until the web app has its own URL.
CORS_ORIGINS=https://your-domain.com

# Header in which the hosting proxy puts the visitor's IP address, used to
# limit guest sign-ins per visitor. Railway: X-Real-IP. Leave blank when there
# is no proxy in front of the server.
CLIENT_IP_HEADER=X-Real-IP

# ---- Supabase (your real production project) ----------------
SUPABASE_URL=https://your-prod-project-ref.supabase.co
SUPABASE_ANON_KEY=your-prod-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key
# Optional: only for projects on Supabase's legacy HS256 token signing.
SUPABASE_JWT_SECRET=your-prod-jwt-secret

# ---- Later phases (leave blank for Phase 0) -----------------
PINECONE_API_KEY=
PINECONE_INDEX=
REPLICATE_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
